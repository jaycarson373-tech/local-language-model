# Copy to .env and load server-side (Node: --env-file=.env or your secret manager).
PUBLIC_URL=http://localhost:5173
PORT=3000
DB_PATH=./data/llm.sqlite
# Missing credentials leave dependent features unavailable. No fake credits.
# Select and verify a serving connection before enabling purchases.
ADMIN_KEY=
SOLANA_RPC_URL=
LLM_MINT=
LLM_DECIMALS=
LLM_MIN_HOLDING_ATOMIC=
PAYMENT_RECIPIENT=
EXCLUDED_WALLETS=
# Fixed promotional conversion, backed by cleared funding; nanodollars per whole token.
BURN_UNITS_PER_TOKEN=
BURN_MAX_CREDIT_USD=

# Optional private hardware telemetry; server-side only, never VITE_ variables.
LLM_TELEMETRY_URL=
LLM_TELEMETRY_TOKEN=
# GPU collector defaults (run on the actual NVIDIA host; see NETWORK.md).
LLM_TELEMETRY_BIND=127.0.0.1
LLM_TELEMETRY_PORT=9108

# Public branding (Vercel build variables; these are NOT secrets).
# Leave empty until the actual profile and canonical mint are known.
VITE_X_URL=
VITE_LLM_CA=

# Custom inference: an authenticated HTTPS endpoint implementing the documented SSE subset.
# For a custom endpoint select LLM_MODEL_PROTOCOL=openai-chat-sse.
LLM_MODEL_PROTOCOL=freellmapi-sse
LLM_MODEL_CHAT_URL=
LLM_MODEL_API_KEY=
LLM_MODEL_ID=
LLM_MODEL_PROVIDER=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_CONTEXT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=1024

# Funded hosted serving. These are SERVER ONLY; never VITE_ variables.
# Select LLM_MODEL_PROTOCOL=hosted-credit-sse to use this adapter.
HOSTED_API_BASE_URL=
HOSTED_API_KEY=
HOSTED_MODEL=auto-cheapest
HOSTED_PROVIDER_TAG=
# Private price configuration: 23000 basis points gives the requested 3.3x service rates.
LLM_MARKUP_BPS=23000
# Optional direct backend origin for trusted server-side admin commands.
LLM_ADMIN_BASE_URL=

# Optional launch inventory: total completed + reserved purchase orders; raise after restocking.
PURCHASE_ORDER_LIMIT=5

# FreeLM / FreeLLMAPI serving (server-only; separate from the account backend URL).
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
# Set exact service input/output prices above before enabling credit-backed usage.
# Router quotas are not cleared funds. FreeLM retains its funded obligation checks.
