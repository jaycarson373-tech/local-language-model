# Copy to .env and load server-side (Node: --env-file=.env or your secret manager).
PUBLIC_URL=http://localhost:5173
PORT=3000
DB_PATH=./data/llm.sqlite
# Missing credentials leave dependent features unavailable. No fake credits.
# Custom model is in development; no serving endpoint is configured.
# The archived hosted adapter is not an active model option.
ADMIN_KEY=
SOLANA_RPC_URL=
LLM_MINT=
LLM_DECIMALS=
LLM_MIN_HOLDING_ATOMIC=
PAYMENT_RECIPIENT=
EXCLUDED_WALLETS=
# Fixed promotional conversion, backed by cleared funding; nanodollars per whole token.
BURN_UNITS_PER_TOKEN=
BURN_MAX_CREDIT_USD=

# Optional private hardware telemetry; server-side only, never VITE_ variables.
LLM_TELEMETRY_URL=
LLM_TELEMETRY_TOKEN=
# GPU collector defaults (run on the actual NVIDIA host; see NETWORK.md).
LLM_TELEMETRY_BIND=127.0.0.1
LLM_TELEMETRY_PORT=9108

# Public branding (Vercel build variables; these are NOT secrets).
# Leave empty until the actual profile and canonical mint are known.
VITE_X_URL=
VITE_LLM_CA=

# Custom inference: an authenticated HTTPS endpoint implementing the documented SSE subset.
# Supported protocol is explicit; setting legacy hosted credentials does nothing.
LLM_MODEL_PROTOCOL=openai-chat-sse
LLM_MODEL_CHAT_URL=
LLM_MODEL_API_KEY=
LLM_MODEL_ID=
LLM_MODEL_PROVIDER=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_CONTEXT_TOKENS=
LLM_MAX_OUTPUT_TOKENS=
